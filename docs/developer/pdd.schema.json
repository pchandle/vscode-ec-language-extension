{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pddSchema",
  "title": "Protocol Design Definition",
  "type": "object",
  "required": [
    "protocolDesignVersion",
    "hostMacroGlobal",
    "joinMacroGlobal",
    "modeTemplates"
  ],
  "properties": {
    "protocolDesignVersion": {
      "type": "integer",
      "minimum": 1
    },
    "hostMacroGlobal": {
      "$ref": "#/$defs/macroGlobal"
    },
    "joinMacroGlobal": {
      "$ref": "#/$defs/macroGlobal"
    },
    "modeTemplates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modeTemplate"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "macroGlobal": {
      "type": "object",
      "required": [
        "def",
        "header",
        "footer"
      ],
      "properties": {
        "def": {
          "type": "string",
          "minLength": 1
        },
        "header": {
          "type": "string",
          "minLength": 1
        },
        "footer": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "modeTemplate": {
      "type": "object",
      "required": [
        "name",
        "topics",
        "hostMacroTemplates",
        "joinMacroTemplates"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modeTemplateTopic"
          }
        },
        "hostMacroTemplates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/macroTemplateLine"
          }
        },
        "joinMacroTemplates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/macroTemplateLine"
          }
        }
      },
      "additionalProperties": false
    },
    "modeTemplateTopic": {
      "type": "object",
      "required": [
        "name",
        "role",
        "constraint",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "host",
            "join"
          ]
        },
        "constraint": {
          "type": "string",
          "enum": [
            "requirement",
            "obligation"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "abstraction",
            "integer",
            "string",
            "boolean"
          ]
        },
        "comment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "macroTemplateLine": {
      "type": "string",
      "minLength": 1
    }
  }
}
